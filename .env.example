# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Публічний URL сайту (canonical, Open Graph, sitemap). Без слеша в кінці.
VITE_PUBLIC_SITE_URL=https://quizzes.website

# Google Search Console — код підтвердження власності (опційно).
# Search Console → Налаштування → Підтвердження власності → HTML-тег → вміст атрибута content=
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-code
# Альтернатива: файл public/google440af4eaf84d23ae.html уже на production.

# IndexNow (Bing/Yandex) — ключ у public/quizquestindexnow2026.txt
# INDEXNOW_KEY=quizquestindexnow2026

# --- Site analytics ---
# Після supabase-migrations/009_site_analytics.sql:
#   UPDATE site_analytics_secrets SET token = 'ваш-довгий-секрет-16+' WHERE id = 1;
# Дашборд: https://quizzes.website/admin/stats?t=ваш-довгий-секрет-16+
