# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Публічний URL сайту (canonical, Open Graph, sitemap). Без слеша в кінці.
VITE_PUBLIC_SITE_URL=https://quizquest.app

# Google Search Console — код підтвердження власності (опційно).
# Search Console → Налаштування → Підтвердження власності → HTML-тег → вміст content=
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-code

# --- Site analytics (опційно, лише документація) ---
# Після supabase-migrations/009_site_analytics.sql задайте секрет у БД:
#   UPDATE site_analytics_secrets SET token = 'ваш-довгий-секрет-16+' WHERE id = 1;
# Дашборд (noindex): https://your-domain/admin/stats?t=ваш-довгий-секрет-16+
# Токен НЕ додавайте в VITE_* — лише в закладку URL / поле на сторінці.
